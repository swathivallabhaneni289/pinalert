{
    "swagger": "2.0",
    "info": {
        "description": "Crowd-reported local emergency feed for floods, cyclones, and other disasters.\nReports are posted by nearby people and confirmed or disputed by other nearby\npeople; this API is the read/write surface for that data. Reading and writing\nreports both require a session verified by email through the magic-link flow —\nan unverified caller is refused with 401. Pinalert is an unofficial,\nunaffiliated project and is not a substitute for contacting emergency services.\nThis document is Swagger 2.0 — swag (the generator behind this spec) does not\nemit OpenAPI 3.x, so tooling that expects OpenAPI 3.x specifically should account\nfor that; OPS-01's \"OpenAPI/Swagger spec\" requirement is satisfied by either\nformat.",
        "title": "Pinalert API",
        "contact": {
            "name": "Pinalert project",
            "url": "https://github.com/swathivallabhaneni289/pinalert"
        },
        "license": {
            "name": "Unlicensed (portfolio project, all rights reserved)"
        },
        "version": "1.0"
    },
    "basePath": "/api",
    "paths": {
        "/auth/request-link": {
            "post": {
                "description": "Validates the given email address, mints a single-use 5-minute magic-link\ntoken, persists its hash, and hands the raw link to the configured mailer.\nThe response never carries a session identifier.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Request a magic-link verification email",
                "parameters": [
                    {
                        "description": "Email to verify",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handlers.RequestLinkRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.RequestLinkResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "429": {
                        "description": "Too Many Requests",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/reports": {
            "get": {
                "description": "Runs the indexed bounding-box prefilter followed by exact Haversine distance and\nreturns unexpired reports within radius_km, nearest first. This single endpoint\nserves both the map and the list views — there is no separate map-only route.\nRequires a session verified by email through the magic-link flow; an unverified\ncaller receives 401 and no report data.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "reports"
                ],
                "summary": "List unexpired reports near a point",
                "parameters": [
                    {
                        "type": "number",
                        "description": "Latitude of the query center (required, -90 to 90)",
                        "name": "lat",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "number",
                        "description": "Longitude of the query center (required, -180 to 180)",
                        "name": "lon",
                        "in": "query",
                        "required": true
                    },
                    {
                        "maximum": 50,
                        "minimum": 0.1,
                        "type": "number",
                        "default": 10,
                        "description": "Search radius in kilometers (defaults to 10, bounded to 0.1-50)",
                        "name": "radius_km",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.ReportListResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    }
                }
            },
            "post": {
                "description": "Creates a location-tagged report under the caller's session. Requires a session\nverified by email through the magic-link flow (POST /auth/request-link, then\nGET /auth/verify) — an unverified caller receives 401. id, geohash, created_at\nand expires_at are computed server-side and can never be set by the client.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "reports"
                ],
                "summary": "Submit a new emergency report",
                "parameters": [
                    {
                        "description": "Report to submit",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handlers.SubmitReportRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/handlers.SubmitReportResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "handlers.ErrorDetail": {
            "type": "object",
            "properties": {
                "field": {
                    "type": "string",
                    "example": "category"
                },
                "message": {
                    "type": "string",
                    "example": "Choose a category to continue."
                }
            }
        },
        "handlers.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "$ref": "#/definitions/handlers.ErrorDetail"
                }
            }
        },
        "handlers.ReportListResponse": {
            "type": "object",
            "properties": {
                "reports": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/handlers.ReportResponse"
                    }
                }
            }
        },
        "handlers.ReportResponse": {
            "type": "object",
            "properties": {
                "category": {
                    "type": "string",
                    "enum": [
                        "flood",
                        "earthquake",
                        "fire",
                        "storm_cyclone",
                        "road_blocked",
                        "power_outage",
                        "shelter_open",
                        "rescue_needed",
                        "other"
                    ],
                    "example": "flood"
                },
                "created_at": {
                    "type": "string",
                    "example": "2026-09-05T14:03:00.000Z"
                },
                "description": {
                    "type": "string",
                    "example": "Water rising fast near the market bridge."
                },
                "distance_km": {
                    "description": "DistanceKm is present only in GET /api/reports responses (nil on the report just submitted).",
                    "type": "number",
                    "example": 1.42
                },
                "expires_at": {
                    "type": "string",
                    "example": "2026-09-06T14:03:00.000Z"
                },
                "geohash": {
                    "type": "string",
                    "example": "tdr1qgzp"
                },
                "id": {
                    "type": "integer",
                    "example": 42
                },
                "latitude": {
                    "type": "number",
                    "example": 13.0827
                },
                "longitude": {
                    "type": "number",
                    "example": 80.2707
                },
                "severity": {
                    "type": "string",
                    "enum": [
                        "low",
                        "medium",
                        "critical"
                    ],
                    "example": "critical"
                },
                "shelter_capacity_status": {
                    "description": "ShelterCapacityStatus is present only for shelter_open reports.",
                    "type": "string",
                    "enum": [
                        "available",
                        "limited",
                        "full",
                        "closed"
                    ],
                    "example": "available"
                },
                "shelter_headcount": {
                    "type": "integer",
                    "example": 42
                }
            }
        },
        "handlers.RequestLinkRequest": {
            "type": "object",
            "properties": {
                "email": {
                    "description": "Email is the address to verify. Server-side validation (RFC 5322\naddress parsing, no display-name form) happens in\nservice.AuthService.RequestLink — never trust client-side validation.",
                    "type": "string",
                    "example": "visitor@example.com"
                }
            }
        },
        "handlers.RequestLinkResponse": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string",
                    "example": "visitor@example.com"
                }
            }
        },
        "handlers.SubmitReportRequest": {
            "type": "object",
            "properties": {
                "category": {
                    "description": "Category is one of the nine canonical report categories (internal/service.Categories).",
                    "type": "string",
                    "enum": [
                        "flood",
                        "earthquake",
                        "fire",
                        "storm_cyclone",
                        "road_blocked",
                        "power_outage",
                        "shelter_open",
                        "rescue_needed",
                        "other"
                    ],
                    "example": "flood"
                },
                "description": {
                    "description": "Description is a free-text account of the report, 10-1000 characters.",
                    "type": "string",
                    "example": "Water rising fast near the market bridge."
                },
                "latitude": {
                    "description": "Latitude must be between -90 and 90.",
                    "type": "number",
                    "example": 13.0827
                },
                "longitude": {
                    "description": "Longitude must be between -180 and 180.",
                    "type": "number",
                    "example": 80.2707
                },
                "severity": {
                    "description": "Severity affects triage ordering only; self-declaring critical never bypasses the provisional-visibility gate (internal/service.Severities).",
                    "type": "string",
                    "enum": [
                        "low",
                        "medium",
                        "critical"
                    ],
                    "example": "medium"
                },
                "shelter_capacity_status": {
                    "description": "ShelterCapacityStatus is required when category is shelter_open and forbidden for every other category (internal/service.CapacityStatuses).",
                    "type": "string",
                    "enum": [
                        "available",
                        "limited",
                        "full",
                        "closed"
                    ],
                    "example": "available"
                },
                "shelter_headcount": {
                    "description": "ShelterHeadcount is optional and only valid alongside category shelter_open.",
                    "type": "integer",
                    "example": 42
                }
            }
        },
        "handlers.SubmitReportResponse": {
            "type": "object",
            "properties": {
                "report": {
                    "$ref": "#/definitions/handlers.ReportResponse"
                }
            }
        }
    }
}