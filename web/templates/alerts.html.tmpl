<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {{template "app_head" .AssetVersion}}
  <title>Pinalert: Official alerts</title>
  <link rel="stylesheet" href="/static/css/main.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/auth.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/chrome.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/app-bar.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/places.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/updates.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/official.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/phone.css?v={{.AssetVersion}}">
  <script src="/static/js/theme.js?v={{.AssetVersion}}"></script>
</head>
<body class="has-app-bar">
  <div class="top-chrome">
    {{template "app_topbar" .}}
  </div>
  <div id="notice-live" class="visually-hidden" role="status" aria-live="polite"></div>

  <div class="app-content">
  <main class="place-page" id="official-page" data-account-id="{{.AccountID}}">
    <h1 class="place-head">Official alerts</h1>

    <p class="official-status" id="official-status"></p>

    <div class="official-notice" id="official-notice" role="status" hidden>
      <span class="official-notice__icon" aria-hidden="true"></span>
      <span class="official-notice__text" id="official-notice-text"></span>
    </div>

    <div class="official-skeleton" id="official-skeleton" aria-hidden="true" hidden>
      <div class="skeleton-row"></div>
      <div class="skeleton-row"></div>
      <div class="skeleton-row"></div>
      <div class="skeleton-row"></div>
    </div>

    <section class="place-section official-section" id="official-section" aria-labelledby="official-title" hidden>
      <div class="official-section__head">
        <h2 class="place-section__title" id="official-title"></h2>
        <p class="place-section__line" id="official-districts"></p>
      </div>
      <div class="place-box official-list" id="official-list"></div>
    </section>

    <div class="empty-state place-empty official-state" id="official-empty" hidden>
      <h2 id="official-empty-title"></h2>
      <p id="official-empty-body"></p>
    </div>

    <div class="empty-state place-empty official-state" id="official-unavailable" hidden>
      <h2 id="official-unavailable-title"></h2>
      <p id="official-unavailable-body"></p>
    </div>

    <div class="empty-state place-empty official-state" id="official-noarea" hidden>
      <h2 id="official-noarea-title"></h2>
      <p id="official-noarea-body"></p>
    </div>

    <div class="empty-state place-empty official-state" id="official-error" hidden>
      <h2 id="official-error-title"></h2>
      <p id="official-error-body"></p>
      <button type="button" class="btn" id="official-retry">Try again</button>
    </div>

    <p class="official-attribution" id="official-attribution">Alerts are copied from NDMA SACHET. Pinalert is not an official channel. Hazard events come from the Global Disaster Alert and Coordination System, GDACS.</p>
    <noscript>
      <p class="official-attribution">Turn on JavaScript to see official alerts, or check your state disaster management authority.</p>
    </noscript>
  </main>
  </div>

  {{template "app_bottombar" .}}

  <script src="/static/js/account-menu.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/app-bar.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/updates.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/position.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/official-alerts.js?v={{.AssetVersion}}" defer></script>
</body>
</html>
