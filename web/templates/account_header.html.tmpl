{{define "account_header_menu"}}
  <button type="button" id="account-menu-trigger" class="account-trigger"
          aria-label="Account menu" aria-haspopup="menu" aria-expanded="false"
          aria-controls="account-menu">
    <span class="auth-icon auth-icon--user" aria-hidden="true"></span>
  </button>

  <div id="account-menu" role="menu" hidden>
    <a role="menuitem" class="account-menu__item" href="/settings">
      <span class="auth-icon auth-icon--settings" aria-hidden="true"></span>
      Settings
    </a>
    <form method="post" action="/auth/logout">
      <button type="submit" role="menuitem" class="account-menu__item">
        <span class="auth-icon auth-icon--log-out" aria-hidden="true"></span>
        Log out
      </button>
    </form>
  </div>

  <dialog id="logout-confirm" class="logout-confirm" aria-labelledby="logout-confirm-title">
    <div class="logout-confirm__body">
      <h2 class="logout-confirm__title" id="logout-confirm-title" tabindex="-1">Log out of Pinalert?</h2>
      <div class="logout-confirm__actions">
        <button type="button" class="btn" id="logout-confirm-cancel">Cancel</button>
        <button type="button" class="btn btn--destructive" id="logout-confirm-yes">Log out</button>
      </div>
    </div>
  </dialog>
{{end}}
{{/*
  The person button and its menu. The markup is written once, as
  account_header_menu, and has two callers (Phase 3.4 plan 26, code review
  part 3 WR-05):

    - this file's own root below, a header element, for the pages that have no
      app top bar (the Low data view and the Moderator screen). There it is the
      page's one banner landmark.
    - app_topbar (app_bar.html.tmpl), which wraps the same markup in a div,
      because it already sits inside the top bar's own header and a header may
      not hold another header (two nested banners on a laptop).

  Keep the markup in account_header_menu so the two cannot drift.
*/}}
<header class="app-header">{{template "account_header_menu" .}}</header>
