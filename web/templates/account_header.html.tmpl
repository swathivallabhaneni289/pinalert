<header class="app-header">
  <button type="button" id="account-menu-trigger" class="account-trigger"
          aria-label="Account menu" aria-haspopup="menu" aria-expanded="false"
          aria-controls="account-menu">
    <span class="auth-icon auth-icon--user" aria-hidden="true"></span>
  </button>

  <div id="account-menu" role="menu" hidden>
    <p class="account-menu__email">{{.Email}}</p>
    <a role="menuitem" href="/profile">Activity</a>
    <form method="post" action="/auth/logout">
      <button type="submit" role="menuitem">
        <span class="auth-icon auth-icon--log-out" aria-hidden="true"></span>
        Log out
      </button>
    </form>
  </div>
</header>
