<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {{template "app_head" .AssetVersion}}
  <meta name="robots" content="noindex">
  <title>Pinalert: Moderator screen</title>
  <link rel="stylesheet" href="/static/css/main.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/trust.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/auth.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/chrome.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/moderate.css?v={{.AssetVersion}}">
  <script src="/static/js/theme.js?v={{.AssetVersion}}"></script>
</head>
<body>
  <div class="top-chrome">
    {{template "account_header.html.tmpl" .}}
  </div>
  {{template "theme_toggle.html.tmpl" .}}

  <main class="mod-page">
    <h1>Moderator screen</h1>
    <p class="mod-page__line">Only moderators can open this page.</p>
    <button type="button" class="btn" id="mod-refresh">Refresh lists</button>
    <p class="inline-error" id="mod-refresh-error" role="alert" hidden>Couldn't refresh the lists. Try again.</p>

    <form class="mod-find" id="mod-find-form">
      <label for="mod-find">Find a report</label>
      <input id="mod-find" type="text" autocomplete="off" autocapitalize="off" spellcheck="false" aria-describedby="mod-find-help">
      <p class="mod-find__help" id="mod-find-help">Type the report id, or paste a link that includes report=</p>
      <button type="submit" class="btn btn--primary">Find report</button>
    </form>
    <div id="mod-find-result" aria-live="polite"></div>

    {{/* Quick 261118-rz6 (owner 2026-11-18): the open asks for review from the authors of removed reports, oldest first, each with Why, the author's note, Restore and Keep removed. Filled by script with text nodes only; nothing names who asked. */}}
    <section class="mod-section" aria-labelledby="mod-h-asks">
      <h2 id="mod-h-asks">Review asks <span class="mod-count" id="mod-count-asks"></span></h2>
      <ol class="mod-list" id="mod-list-asks" role="list" aria-labelledby="mod-h-asks"></ol>
      <p class="mod-empty" id="mod-empty-asks" hidden>No review asks.</p>
    </section>

    <section class="mod-section" aria-labelledby="mod-h-auto">
      <h2 id="mod-h-auto">Flagged by the automatic check <span class="mod-count" id="mod-count-auto"></span></h2>
      <p class="mod-section__line">Posted normally, but the text scored near the line. Newest first.</p>
      <ol class="mod-list" id="mod-list-auto" role="list" aria-labelledby="mod-h-auto"></ol>
      <p class="mod-empty" id="mod-empty-auto" hidden>No reports flagged by the check.</p>
    </section>

    <section class="mod-section" aria-labelledby="mod-h-people">
      <h2 id="mod-h-people">Flagged by people <span class="mod-count" id="mod-count-people"></span></h2>
      <p class="mod-section__line">People used Flag this report. Hidden by flags and Still showing first, then most flags.</p>
      <ol class="mod-list" id="mod-list-people" role="list" aria-labelledby="mod-h-people"></ol>
      <p class="mod-empty" id="mod-empty-people" hidden>No reports flagged by people.</p>
    </section>

    <section class="mod-section" aria-labelledby="mod-h-pending">
      <h2 id="mod-h-pending">Text check not finished <span class="mod-count" id="mod-count-pending"></span></h2>
      <p class="mod-section__line">The check couldn't finish. Serious reports in this list are already published. Waiting longest first.</p>
      <ol class="mod-list" id="mod-list-pending" role="list" aria-labelledby="mod-h-pending"></ol>
      <p class="mod-empty" id="mod-empty-pending" hidden>No unfinished checks.</p>
    </section>

    {{/* Quick 261118-rz6: reports removed in the last 30 days, newest first, each with Why and Restore. */}}
    <section class="mod-section" aria-labelledby="mod-h-removed">
      <h2 id="mod-h-removed">Removed <span class="mod-count" id="mod-count-removed"></span></h2>
      <ol class="mod-list" id="mod-list-removed" role="list" aria-labelledby="mod-h-removed"></ol>
      <p class="mod-empty" id="mod-empty-removed" hidden>No removed reports.</p>
    </section>

    <section class="mod-section" aria-labelledby="mod-h-comments">
      <h2 id="mod-h-comments">Comments <span class="mod-count" id="mod-count-comments"></span></h2>
      <ol class="mod-list" id="mod-list-comments" role="list" aria-labelledby="mod-h-comments"></ol>
      <p class="mod-empty" id="mod-empty-comments" hidden>No comments to review.</p>
    </section>

    {{/* Phase 9 plan 15 (D-14, UI-SPEC P9-C30): the tapped ratings tool. A moderator types one reporter's username, reads who gave how many stars, removes one rating or every rating one person gave. The list is filled by script with text nodes only. A rater's username appears on this screen and nowhere else. */}}
    <section class="mod-section" aria-labelledby="mod-h-ratings">
      <h2 id="mod-h-ratings">Ratings</h2>
      <p class="mod-section__line">Find one reporter's tapped ratings. Removed ratings stop counting at once.</p>
      <form class="mod-find" id="mod-ratings-form">
        <label for="mod-ratings-name">Reporter's username</label>
        <input id="mod-ratings-name" type="text" autocomplete="off" autocapitalize="off" spellcheck="false">
        <button type="submit" class="btn btn--primary">Show ratings</button>
      </form>
      <p class="inline-error" id="mod-ratings-error" role="alert" hidden></p>
      <div id="mod-ratings-status" aria-live="polite"></div>
      <ol class="mod-list" id="mod-ratings-list" role="list" aria-labelledby="mod-h-ratings"></ol>
    </section>

    {{/* The box that asks before Remove all by one rater: a native dialog built like the Delete box of Settings (#settings-delete-confirm). The title takes the first focus, no button is outlined on open, there is no close X, and only Cancel and Remove all answer it. It sits inside main so the page script reaches its buttons. */}}
    <dialog id="mod-ratings-confirm" class="logout-confirm" aria-labelledby="mod-ratings-confirm-title" aria-describedby="mod-ratings-confirm-text">
      <div class="logout-confirm__body">
        <h2 class="logout-confirm__title" id="mod-ratings-confirm-title" tabindex="-1"></h2>
        <div class="logout-confirm__text" id="mod-ratings-confirm-text">
          <p>Their ratings stop counting for every reporter, and they cannot rate again.</p>
        </div>
        <p class="inline-error" id="mod-ratings-confirm-error" role="alert" hidden></p>
        <div class="logout-confirm__actions">
          <button type="button" class="btn" id="mod-ratings-confirm-cancel" data-mod-rating-action="box-cancel">Cancel</button>
          <button type="button" class="btn btn--destructive" id="mod-ratings-confirm-go" data-mod-rating-action="box-go">Remove all</button>
        </div>
      </div>
    </dialog>

    {{/* Quick 261118-rz6 (owner 2026-11-18): Remove report asks why first, in a box built like the Log out box (.logout-confirm). The title takes the first focus, no button is outlined on open, and only Cancel and Remove answer it. The five reasons are one radio group of real buttons; Remove stays off until one is picked. It sits inside main so the page script reaches its buttons. */}}
    <dialog id="mod-remove-confirm" class="logout-confirm" aria-labelledby="mod-remove-title">
      <div class="logout-confirm__body">
        <h2 class="logout-confirm__title" id="mod-remove-title" tabindex="-1">Why remove?</h2>
        <div class="mod-reasons" id="mod-remove-reasons" role="radiogroup" aria-labelledby="mod-remove-title">
          <button type="button" class="btn mod-reason" role="radio" aria-checked="false" tabindex="0" data-mod-reason="spam">Spam</button>
          <button type="button" class="btn mod-reason" role="radio" aria-checked="false" tabindex="-1" data-mod-reason="abusive">Abusive</button>
          <button type="button" class="btn mod-reason" role="radio" aria-checked="false" tabindex="-1" data-mod-reason="false">False</button>
          <button type="button" class="btn mod-reason" role="radio" aria-checked="false" tabindex="-1" data-mod-reason="dangerous">Dangerous</button>
          <button type="button" class="btn mod-reason" role="radio" aria-checked="false" tabindex="-1" data-mod-reason="other">Other</button>
        </div>
        <div class="logout-confirm__actions mod-remove-confirm__actions">
          <button type="button" class="btn" id="mod-remove-cancel" data-mod-remove-box="cancel">Cancel</button>
          <button type="button" class="btn btn--destructive btn--off" id="mod-remove-go" data-mod-remove-box="go" aria-disabled="true">Remove</button>
        </div>
      </div>
    </dialog>
  </main>

  <div id="toast" role="status" aria-live="polite" hidden></div>

  <script src="/static/js/app.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/trust.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/moderate.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/account-menu.js?v={{.AssetVersion}}" defer></script>
</body>
</html>
