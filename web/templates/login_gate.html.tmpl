<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {{template "app_head" .AssetVersion}}
  <title>Pinalert: Verify your email</title>
  <link rel="stylesheet" href="/static/css/main.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/auth.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/chrome.css?v={{.AssetVersion}}">
  {{if not .LowDataDefault}}{{template "login_globe_css" .}}{{end}}
  <script src="/static/js/theme.js?v={{.AssetVersion}}"></script>
</head>
<body>
  <div class="login-gate{{if not .LowDataDefault}} has-globe{{end}}" id="login-gate">
    <div class="login-column">
    <div class="login-card" id="login-form-panel"{{if .Sent}} hidden{{end}}>
      {{if .DoneLine}}<p class="login-done" role="status">{{.DoneLine}}</p>{{end}}
      <h1>Verify your email to continue</h1>
      <p>Pinalert requires a verified email before you can view or report anything nearby. We'll send a one-time link. No password needed.</p>

      <label for="login-email">Email address</label>
      <div class="login-field">
        <span class="auth-icon auth-icon--mail" aria-hidden="true"></span>
        <input type="email" id="login-email" name="email" placeholder="you@example.com"
               autocomplete="email" required value="{{.Email}}">
      </div>

      <p id="auth-error" class="auth-error" role="alert"></p>

      <button type="button" id="request-link" class="btn btn--primary">Send verification link</button>
    </div>

    {{template "check_inbox.html.tmpl" .}}

    <div class="login-ways">
      {{if .LowDataDefault}}
      <p class="login-ways__note">Low data view is on for this device. It opens after you sign in.</p>
      <a class="login-ways__off" href="/login?low=0">Turn off</a>
      {{else}}
      <a class="login-ways__low" href="/login?low=1">Low data view</a>
      <p class="login-ways__line">Text only, no map</p>
      {{end}}
      {{template "login_ways_links" .}}
    </div>
    </div>
    {{if not .LowDataDefault}}{{template "login_globe" .}}{{end}}
  </div>

  <script src="/static/js/auth.js?v={{.AssetVersion}}" defer></script>
  {{if not .LowDataDefault}}{{template "login_globe_script" .}}{{end}}
</body>
</html>
