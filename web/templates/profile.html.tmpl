<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Pinalert: Activity</title>
  <link rel="stylesheet" href="/static/css/main.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/feed.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/trust.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/auth.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/chrome.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/activity.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/phone.css?v={{.AssetVersion}}">
  <script src="/static/js/theme.js?v={{.AssetVersion}}"></script>
</head>
<body>
  <div class="top-chrome">
    {{template "disclaimer_bar.html.tmpl" .}}
    {{template "account_header.html.tmpl" .}}
  </div>
  {{template "theme_toggle.html.tmpl" .}}
  <div id="notice-live" class="visually-hidden" role="status" aria-live="polite"></div>

  <main class="profile-page" data-account-id="{{.AccountID}}">
    <a href="{{if .LowDataDefault}}/low{{else}}/{{end}}" class="profile-back-link" aria-label="{{if .LowDataDefault}}Back to Low data view{{else}}Back to map{{end}}" title="{{if .LowDataDefault}}Back to Low data view{{else}}Back to map{{end}}"><span class="auth-icon auth-icon--arrow-left" aria-hidden="true"></span></a>

    <p class="profile-email">{{.Email}}</p>

    <section class="profile-activity">
      <h2>Activity</h2>
      <div class="queue-strip" id="queue-strip" hidden></div>
      <p class="activity-subtitle">A quick view of what's happening with your reports.</p>

      <form class="profile-logout" method="post" action="/auth/logout">
        <button type="submit" class="profile-logout__button">Log out</button>
      </form>

      {{with .Record}}
      <section class="profile-record" aria-label="Your reporter record">
        <p class="profile-record__kicker">Your reporter record</p>
        <p class="profile-record__label">{{.Label}}</p>
        <p class="profile-record__counts">{{.Counts}}</p>
      </section>
      {{end}}

      <nav class="activity-tabs" aria-label="Activity views">
        {{range .Tabs}}
        <a class="activity-tab" href="{{.Href}}" data-tab="{{.Key}}" data-count="{{.Count}}"{{if .Selected}} aria-current="page"{{end}}><span class="activity-tab__label">{{.Label}}</span><span class="activity-tab__count">{{.Count}}</span></a>
        {{end}}
      </nav>

      {{if .Reports}}
      <ol class="profile-report-list">
        {{range .Reports}}
        <li class="report-row activity-card activity-card--{{.Kind}} {{.SeverityClass}} {{.VisibilityClass}}"
            data-report-id="{{.ReportID}}"
            data-visibility="{{.Visibility}}"
            data-visibility-reason="{{.VisibilityReason}}"
            data-expired="{{.Expired}}"
            {{if not .Moderation}}data-trust="{{.TrustJSON}}"{{end}}
            {{if .Moderation}}data-moderation="{{.Moderation}}"{{end}}
            data-tabs="{{.Tabs}}"
            {{if .CanReopen}}data-can-reopen="true"{{end}}
            {{if .UndosUsed}}data-undos-used="true"{{end}}
            {{if .Hidden}}hidden{{end}}>
          <span class="icon-badge activity-card__icon" aria-hidden="true"><span class="icon-glyph {{.IconGlyph}}"></span></span>
          <div class="report-row__body">
            <span class="activity-card__tag">{{.Tag}}</span>
            <p class="report-row__title">{{.Description}}</p>
            <p class="report-row__meta activity-card__sub"><span class="activity-card__action">{{.Action}} &middot; </span>{{.When}} &middot; {{.Detail}}</p>
            {{if .WrittenText}}<p class="report-row__meta">{{.WrittenText}}</p>{{end}}
            {{if .ModerationNote}}<p class="report-row__moderation-note">{{.ModerationNote}}{{if and .PolicyPointer $.Chrome.ContactEmail}} {{$.PolicyPointerLead}}<a href="/policy">{{$.PolicyPointerLink}}</a>{{$.PolicyPointerTail}}{{end}}</p>{{end}}
          </div>
          <span class="activity-chip"><span class="activity-chip__word activity-chip__word--severity">{{.SeverityWord}}</span><span class="activity-chip__word activity-chip__word--resolved">Resolved</span><span class="activity-chip__word activity-chip__word--open">Not resolved</span></span>
        </li>
        {{end}}
      </ol>
      {{end}}

      {{range .Tabs}}
      <div class="empty-state profile-empty-state activity-empty" data-tab-empty="{{.Key}}"{{if not .ShowEmpty}} hidden{{end}}>
        <h3>{{.EmptyTitle}}</h3>
        <p>{{.EmptyText}}</p>
      </div>
      {{end}}
    </section>
  </main>

  <nav class="bottom-nav" aria-label="Main">
    <a class="bottom-nav__tab" href="/">Feed</a>
    <a class="bottom-nav__tab" href="/profile" aria-current="page">Activity</a>
  </nav>

  <div id="toast" role="status" aria-live="polite" hidden></div>

  <script src="/static/js/app.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/votes.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/visibility.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/trust.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/queue.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/activity.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/activity-tabs.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/account-menu.js?v={{.AssetVersion}}" defer></script>
</body>
</html>
