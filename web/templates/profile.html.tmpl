<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Pinalert: My activity</title>
  <link rel="stylesheet" href="/static/css/main.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/feed.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/trust.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/auth.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/chrome.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/activity.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/app-bar.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/phone.css?v={{.AssetVersion}}">
  <script src="/static/js/theme.js?v={{.AssetVersion}}"></script>
</head>
<body class="has-app-bar">
  <div class="top-chrome">
    {{template "app_topbar" .}}
  </div>
  <div id="notice-live" class="visually-hidden" role="status" aria-live="polite"></div>

  <div class="app-content">
  <main class="profile-page" data-account-id="{{.AccountID}}" data-part="{{.CurrentPart}}" data-resend-page="{{if .LowDataDefault}}/low{{else}}/{{end}}" data-default-radius-km="{{.DefaultRadiusKm}}">
    <h1 class="activity-heading">My activity</h1>

    <div class="queue-strip" id="queue-strip" hidden></div>

    <nav class="activity-hub" aria-label="My activity">
      {{range .Parts}}
      <a class="activity-hub__row" href="{{.Href}}" data-part-link="{{.Key}}"><span class="activity-hub__tile" aria-hidden="true"><span class="app-icon app-icon--{{.Icon}}"></span></span><span class="activity-hub__text"><span class="activity-hub__name">{{.Name}}</span><span class="activity-hub__summary">{{.Summary}}</span></span>{{if .ShowCount}}<span class="activity-hub__count">{{.Count}}</span>{{else if eq .Key "ended"}}<span class="activity-hub__count" id="ended-hub-count" hidden></span>{{end}}<span class="app-icon app-icon--chevron-right activity-hub__chevron" aria-hidden="true"></span></a>
      {{end}}
    </nav>

    {{range .Parts}}
    <section class="activity-part activity-part--{{.Key}}" id="part-{{.Key}}" data-part-key="{{.Key}}"{{if .Current}} data-current{{end}} aria-labelledby="activity-title-{{.Key}}">
      <div class="activity-part__head">
        <h2 class="activity-part__title" id="activity-title-{{.Key}}">{{.Name}}{{if .ShowCount}} <span class="activity-part__count">{{.Count}}</span>{{else if eq .Key "ended"}} <span class="activity-part__count" id="ended-title-count" hidden></span>{{end}}</h2>
        <p class="activity-part__line">{{.Line}}</p>
      </div>
      <div class="activity-part__body">
        {{if eq .Key "posted"}}
        {{with $.Record}}
        <section class="profile-record" aria-label="Your reporter record">
          <p class="profile-record__kicker">Your reporter record</p>
          <p class="profile-record__label">{{.Label}}</p>
          <p class="profile-record__counts">{{.Counts}}</p>
        </section>
        {{end}}
        {{end}}

        {{if eq .Key "ended"}}
        <div class="activity-box" id="ended-nearby">
          <div class="activity-skeleton" id="ended-skeleton">
            <div class="skeleton-row"></div>
            <div class="skeleton-row"></div>
            <div class="skeleton-row"></div>
            <div class="skeleton-row"></div>
          </div>
          <div class="activity-cols" id="ended-cols" aria-hidden="true" hidden>
            <span class="activity-cols__disc"></span>
            <span>Report</span>
            <span>Status</span>
            <span>What happened</span>
            <span>When</span>
            <span class="activity-cols__distance">Distance</span>
          </div>
          <div class="activity-group" id="ended-resolved" hidden>
            <p class="activity-group__label">Resolved</p>
            <ol class="activity-group__list profile-report-list" id="ended-resolved-list"></ol>
            <p class="activity-group__cut" id="ended-resolved-cut" hidden></p>
          </div>
          <div class="activity-group" id="ended-faded" hidden>
            <p class="activity-group__label">Faded out</p>
            <ol class="activity-group__list profile-report-list" id="ended-faded-list"></ol>
            <p class="activity-group__cut" id="ended-faded-cut" hidden></p>
          </div>
          <div class="empty-state profile-empty-state activity-empty" id="ended-empty" hidden>
            <h3>{{.EmptyTitle}}</h3>
            <p>{{.EmptyText}}</p>
          </div>
          <div class="empty-state profile-empty-state activity-empty" id="ended-location" hidden>
            <h3>Ended nearby needs your location</h3>
            <p>Open Nearby and allow location, then come back.</p>
          </div>
          <div class="error-state activity-empty" id="ended-error" hidden>
            <h3>Couldn't load reports</h3>
            <p>Check your connection and try again.</p>
            <button type="button" class="activity-retry" id="ended-retry">Try again</button>
          </div>
        </div>
        {{else}}
        <div class="activity-box">
          {{if .Rows}}
          <div class="activity-cols" aria-hidden="true">
            <span class="activity-cols__disc"></span>
            <span>Report</span>
            <span>Status</span>
            <span>What happened</span>
            <span>When</span>
            <span class="activity-cols__distance">Distance</span>
          </div>
          <ol class="profile-report-list">
            {{range .Rows}}
            <li class="report-row activity-card activity-card--{{.Kind}} {{.SeverityClass}} {{.VisibilityClass}}"
                data-report-id="{{.ReportID}}"
                data-visibility="{{.Visibility}}"
                data-visibility-reason="{{.VisibilityReason}}"
                data-expired="{{.Expired}}"
                {{if not .Moderation}}data-trust="{{.TrustJSON}}"{{end}}
                {{if .Moderation}}data-moderation="{{.Moderation}}"{{end}}
                {{if .CanReopen}}data-can-reopen="true"{{end}}
                {{if .UndosUsed}}data-undos-used="true"{{end}}>
              <span class="icon-badge activity-card__icon" aria-hidden="true"><span class="icon-glyph {{.IconGlyph}}"></span></span>
              <div class="activity-card__report">
                <p class="report-row__title">{{.Description}}</p>
                <p class="report-row__meta activity-card__sub">{{.Detail}}{{if .WrittenText}} &middot; {{.WrittenText}}{{end}}</p>
                {{if .ModerationNote}}<p class="report-row__moderation-note">{{.ModerationNote}}{{if and .PolicyPointer $.Chrome.ContactEmail}} {{$.PolicyPointerLead}}<a href="/policy">{{$.PolicyPointerLink}}</a>{{$.PolicyPointerTail}}{{end}}</p>{{end}}
              </div>
              <div class="activity-card__status"><span class="visually-hidden">{{.SeverityWord}} severity. </span><span class="activity-chip" data-word-ongoing="Ongoing" data-word-disputed="Disputed">{{.StatusWord}}</span></div>
              <div class="activity-card__what"></div>
              <p class="activity-card__when">{{.WhenText}}</p>
              <p class="activity-card__distance" data-distance-for="{{.ReportID}}" data-lat="{{.Lat}}" data-lon="{{.Lon}}">Unknown</p>
            </li>
            {{end}}
          </ol>
          {{else}}
          <div class="empty-state profile-empty-state activity-empty">
            <h3>{{.EmptyTitle}}</h3>
            <p>{{.EmptyText}}</p>
          </div>
          {{end}}
        </div>
        {{end}}
      </div>
    </section>
    {{end}}
  </main>
  </div>

  <div id="toast" role="status" aria-live="polite" hidden></div>

  {{template "app_bottombar" .}}

  <script src="/static/js/app.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/votes.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/position.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/visibility.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/trust.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/ended-cards.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/ended-nearby.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/queue.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/activity.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/account-menu.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/app-bar.js?v={{.AssetVersion}}" defer></script>
</body>
</html>
