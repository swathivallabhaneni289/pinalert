<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Pinalert: Activity</title>
  <link rel="stylesheet" href="/static/css/main.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/feed.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/trust.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/auth.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/phone.css?v={{.AssetVersion}}">
  <script src="/static/js/theme.js?v={{.AssetVersion}}"></script>
</head>
<body>
  {{template "account_header.html.tmpl" .}}
  {{template "theme_toggle.html.tmpl" .}}

  <main class="profile-page">
    <a href="/" class="profile-back-link" aria-label="Back to map" title="Back to map"><span class="auth-icon auth-icon--arrow-left" aria-hidden="true"></span></a>

    <p class="profile-email">{{.Email}}</p>

    <section class="profile-activity">
      <h2>Activity</h2>

      <form class="profile-logout" method="post" action="/auth/logout">
        <button type="submit" class="profile-logout__button">Log out</button>
      </form>

      {{with .Record}}
      <section class="profile-record" aria-label="Your reporter record">
        <p class="profile-record__kicker">Your reporter record</p>
        <p class="profile-record__label">{{.Label}}</p>
        <p class="profile-record__counts">{{.Counts}}</p>
      </section>
      {{end}}

      {{if .Reports}}
      <ol class="profile-report-list">
        {{range .Reports}}
        <li class="report-row {{.SeverityClass}} {{.VisibilityClass}}"
            data-report-id="{{.ReportID}}"
            data-visibility="{{.Visibility}}"
            data-visibility-reason="{{.VisibilityReason}}"
            data-expired="{{.Expired}}"
            data-trust="{{.TrustJSON}}"
            {{if .CanReopen}}data-can-reopen="true"{{end}}>
          <span class="icon-badge icon-badge--sm">
            <span class="icon-glyph {{.CategoryGlyph}}" aria-hidden="true"></span>
          </span>
          <div class="report-row__body">
            <span class="severity-label severity-label--{{.SeverityLevel}}">{{.SeverityWord}}</span>
            <p class="report-row__title">{{.Description}}</p>
            <p class="report-row__meta">{{.MetaText}}</p>
          </div>
        </li>
        {{end}}
      </ol>
      {{else}}
      <div class="empty-state profile-empty-state">
        <h3>No reports yet</h3>
        <p>Reports you submit will appear here.</p>
      </div>
      {{end}}
    </section>
  </main>

  <nav class="bottom-nav" aria-label="Main">
    <a class="bottom-nav__tab" href="/">Feed</a>
    <a class="bottom-nav__tab" href="/profile" aria-current="page">Activity</a>
  </nav>

  <div id="toast" role="status" aria-live="polite" hidden></div>

  <script src="/static/js/app.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/votes.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/visibility.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/trust.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/activity.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/account-menu.js?v={{.AssetVersion}}" defer></script>
</body>
</html>
