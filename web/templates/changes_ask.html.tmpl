{{/*
  changes_ask: the pop-up that asks "Tell you when this report changes?" the
  first time a person posts a report or confirms or disputes one (Phase 3.3
  plan 20, the 03.3-UAT gap for test 4, owner 2026-10-27: ask in the flow,
  Settings only for changing your mind). It has the Log out box look from
  auth.css (.logout-confirm). Plan 21 renders it on Nearby and Low data, only
  while the account's Changes switch is off; changes-ask.js opens it.
*/}}
{{define "changes_ask"}}
  <dialog id="changes-ask" class="logout-confirm" aria-labelledby="changes-ask-title">
    <div class="logout-confirm__body">
      <h2 class="logout-confirm__title" id="changes-ask-title" tabindex="-1">Tell you when this report changes?</h2>
      <div class="logout-confirm__actions">
        <button type="button" class="btn" id="changes-ask-later">Not now</button>
        <button type="button" class="btn btn--primary" id="changes-ask-allow">Allow</button>
      </div>
    </div>
  </dialog>
{{end}}
