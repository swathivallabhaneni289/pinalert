<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Pinalert: Settings</title>
  <link rel="stylesheet" href="/static/css/main.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/auth.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/chrome.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/app-bar.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/places.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/legal.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/window.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/updates.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/phone.css?v={{.AssetVersion}}">
  <script src="/static/js/theme.js?v={{.AssetVersion}}"></script>
</head>
<body class="has-app-bar">
  <div class="top-chrome">
    {{template "app_topbar" .}}
  </div>
  <div id="notice-live" class="visually-hidden" role="status" aria-live="polite"></div>

  <div class="app-content">
  <main class="place-page place-page--settings" data-account-id="{{.AccountID}}">
    <h1 class="place-head">Settings</h1>

    <section class="place-section" aria-labelledby="settings-you-title">
      <div class="place-section__intro">
        <h2 class="place-section__title" id="settings-you-title">About you</h2>
        <p class="place-section__line">Your name and home area. Shown only on your public profile.</p>
      </div>
      <div class="place-box">
        <button type="button" class="place-row" id="settings-name-row" aria-haspopup="dialog" data-value="{{.DisplayName}}">
          <span class="place-row__text">
            <span class="place-row__label">Name</span>
            <span class="place-row__sub">Shown only if you let others follow you</span>
          </span>
          <span class="place-row__value" id="settings-name-value">{{if .DisplayName}}{{.DisplayName}}{{else}}Not set{{end}}</span>
          <span class="app-icon app-icon--chevron-right" aria-hidden="true"></span>
        </button>
        <button type="button" class="place-row" id="settings-home-row" aria-haspopup="dialog" data-value="{{.HomeAreaName}}">
          <span class="place-row__text">
            <span class="place-row__label">Home area</span>
            <span class="place-row__sub">Used for alerts, never your exact spot</span>
          </span>
          <span class="place-row__value" id="settings-home-value">{{if .HomeAreaName}}{{.HomeAreaName}}{{else}}Not set{{end}}</span>
          <span class="app-icon app-icon--chevron-right" aria-hidden="true"></span>
        </button>
      </div>
    </section>

    <section class="place-section" id="settings-alerts-section" aria-labelledby="settings-phone-title">
      <div class="place-section__intro">
        <h2 class="place-section__title" id="settings-phone-title">Notifications</h2>
        {{/* Owner 2026-10-18 (Q4): the section is called Notifications, with no extra line about the app being open; Phase 3.3 adds its phone rows to this same section. */}}
        <p class="place-section__line">Hear about Reliable reporters near your home area.</p>
      </div>
      {{/* One classless wrapper, so on the laptop grid the boxes and the error line are one item beside the title, not three. */}}
      <div>
      <div class="place-box" id="settings-alerts-on"{{if not .HasHomeArea}} hidden{{end}}>
        <label class="place-row place-row--switch" id="settings-reliable-row" for="settings-reliable-switch">
          <span class="place-row__text">
            <span class="place-row__label">A Reliable reporter posts near me</span>
          </span>
          <input class="place-switch" type="checkbox" role="switch" id="settings-reliable-switch" name="reliable_alerts"{{if .AlertsOn}} checked{{end}}>
        </label>
        <div class="place-row" id="settings-radius-row">
          <label class="place-row__text" for="settings-radius-select">
            <span class="place-row__label">How far from my home area</span>
          </label>
          <select class="place-select" id="settings-radius-select" name="alert_radius_km">
            {{- range .AlertRadii}}
            <option value="{{.}}"{{if eq . $.AlertRadiusKm}} selected{{end}}>{{.}} km</option>
            {{- end}}
          </select>
        </div>
      </div>
      <div class="place-box" id="settings-alerts-off"{{if .HasHomeArea}} hidden{{end}}>
        <button type="button" class="place-row" id="settings-reliable-nohome" aria-haspopup="dialog">
          <span class="place-row__text">
            <span class="place-row__label">A Reliable reporter posts near me</span>
            <span class="place-row__sub">Add a home area first</span>
          </span>
          <span class="app-icon app-icon--chevron-right" aria-hidden="true"></span>
        </button>
      </div>
      <p class="inline-error" id="settings-alerts-error" role="alert" hidden></p>
      </div>
    </section>

    <section class="place-section" aria-labelledby="settings-people-title">
      <div class="place-section__intro">
        <h2 class="place-section__title" id="settings-people-title">People and reports</h2>
        <p class="place-section__line">Reports you have turned updates off for.</p>
      </div>
      <div class="place-box">
        <button type="button" class="place-row" id="settings-muted-row" aria-haspopup="dialog">
          <span class="place-row__text">
            <span class="place-row__label">Muted reports</span>
          </span>
          <span class="place-row__value" id="settings-muted-value">{{.MutedCount}}</span>
          <span class="app-icon app-icon--chevron-right" aria-hidden="true"></span>
        </button>
      </div>
    </section>

    <section class="place-section" aria-labelledby="settings-about-title">
      <div class="place-section__intro">
        <h2 class="place-section__title" id="settings-about-title">About Pinalert</h2>
        <p class="place-section__line">The rules, how your data is used, and a text only version for weak networks.</p>
      </div>
      <div class="place-box">
        <a class="place-row" href="/disclaimer" data-open-reader="disclaimer">
          <span class="place-row__text">
            <span class="place-row__label">Disclaimer</span>
            <span class="place-row__sub">Unofficial service, what it can and cannot promise</span>
          </span>
          <span class="app-icon app-icon--chevron-right" aria-hidden="true"></span>
        </a>
        <a class="place-row" href="/policy#policy" data-open-reader="policy">
          <span class="place-row__text">
            <span class="place-row__label">Policy</span>
            <span class="place-row__sub">Privacy, data kept, reporting rules</span>
          </span>
          <span class="app-icon app-icon--chevron-right" aria-hidden="true"></span>
        </a>
        <a class="place-row" href="/low">
          <span class="place-row__text">
            <span class="place-row__label">Low data view</span>
            <span class="place-row__sub">Text only, no map</span>
          </span>
          <span class="app-icon app-icon--chevron-right" aria-hidden="true"></span>
        </a>
      </div>
    </section>

    <section class="place-section" aria-labelledby="settings-account-title">
      <div class="place-section__intro">
        <h2 class="place-section__title" id="settings-account-title">Account</h2>
        <p class="place-section__line">Log out everywhere, or delete your account.</p>
      </div>
      <div class="place-box">
        <form class="place-row-form" method="post" action="/auth/logout">
          <button type="submit" class="place-row place-row--button">
            <span class="place-row__text">
              <span class="place-row__label">Log out</span>
            </span>
          </button>
        </form>
        <button type="button" class="place-row" id="settings-logout-all-row" aria-haspopup="dialog">
          <span class="place-row__text">
            <span class="place-row__label">Log out of all devices</span>
          </span>
          <span class="app-icon app-icon--chevron-right" aria-hidden="true"></span>
        </button>
        <button type="button" class="place-row" id="settings-delete-row" aria-haspopup="dialog">
          <span class="place-row__text">
            <span class="place-row__label place-row__label--danger">Delete my account</span>
          </span>
          <span class="app-icon app-icon--chevron-right" aria-hidden="true"></span>
        </button>
      </div>
    </section>
  </main>
  </div>

  <div class="app-window app-window--edit" id="settings-name-window" hidden>
    <div class="app-window__panel" role="dialog" aria-modal="true" aria-labelledby="settings-name-title">
      <div class="app-window__head">
        <h2 class="app-window__title" id="settings-name-title">Name</h2>
        <button type="button" class="app-window__close" id="settings-name-close" aria-label="Close"><span class="app-icon app-icon--x" aria-hidden="true"></span></button>
      </div>
      <form class="app-window__body" id="settings-name-form" novalidate>
        <label class="app-window__label" for="settings-name-input">Your name</label>
        <input class="app-window__field" type="text" id="settings-name-input" name="display_name" maxlength="60" autocomplete="name" placeholder="For example: Ravi Kumar">
        <p class="inline-error" id="settings-name-error" role="alert" hidden></p>
        <div class="app-window__actions">
          <button type="submit" class="btn btn--primary" id="settings-name-save">Save name</button>
        </div>
      </form>
    </div>
  </div>

  <div class="app-window app-window--edit" id="settings-home-window" hidden>
    <div class="app-window__panel" role="dialog" aria-modal="true" aria-labelledby="settings-home-title">
      <div class="app-window__head">
        <h2 class="app-window__title" id="settings-home-title">Home area</h2>
        <button type="button" class="app-window__close" id="settings-home-close" aria-label="Close"><span class="app-icon app-icon--x" aria-hidden="true"></span></button>
      </div>
      <div class="app-window__body">
        <form id="settings-home-form" novalidate>
          <label class="app-window__label" for="settings-home-input">Home area</label>
          <input class="app-window__field" type="search" id="settings-home-input" name="q" maxlength="200" autocomplete="off" enterkeyhint="search" placeholder="Search a place" aria-describedby="settings-home-help settings-home-status">
        </form>
        <p class="app-window__help" id="settings-home-help">A town or area, never your street. Used for alerts.</p>
        <p class="app-window__status" id="settings-home-status" role="status" aria-live="polite" hidden></p>
        <ul class="app-window__results" id="settings-home-results" role="listbox" aria-label="Places found" hidden></ul>
        <p class="inline-error" id="settings-home-error" role="alert" hidden></p>
        <p class="app-window__help" id="settings-home-alerts-note"{{if not .AlertsOn}} hidden{{end}}>Removing it also turns off Reliable reporter alerts.</p>
        <div class="app-window__actions">
          <button type="button" class="btn btn--primary" id="settings-home-save" disabled>Save home area</button>
          <button type="button" class="app-window__quiet" id="settings-home-remove"{{if not .HomeAreaName}} hidden{{end}}>Remove home area</button>
        </div>
      </div>
    </div>
  </div>

  <div class="app-window app-window--edit" id="settings-muted-window" hidden>
    <div class="app-window__panel" role="dialog" aria-modal="true" aria-labelledby="settings-muted-title">
      <div class="app-window__head">
        <h2 class="app-window__title" id="settings-muted-title" tabindex="-1">Muted reports</h2>
        <button type="button" class="app-window__close" id="settings-muted-close" aria-label="Close"><span class="app-icon app-icon--x" aria-hidden="true"></span></button>
      </div>
      <div class="app-window__body">
        <div id="settings-muted-loading" aria-hidden="true" hidden>
          <div class="skeleton-row"></div>
          <div class="skeleton-row"></div>
          <div class="skeleton-row"></div>
          <div class="skeleton-row"></div>
        </div>
        <ul class="muted-list" id="settings-muted-list" hidden></ul>
        <div id="settings-muted-empty" hidden>
          <div class="empty-state profile-empty-state">
            <h3 id="settings-muted-empty-title" tabindex="-1">No muted reports</h3>
            <p>Reports you mute show here, with a way to turn them back on.</p>
          </div>
        </div>
        <div id="settings-muted-error" hidden>
          <div class="error-state profile-empty-state">
            <h3>Couldn't load muted reports</h3>
            <p>Check your connection and try again.</p>
            <button type="button" class="btn" id="settings-muted-retry">Try again</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="app-window app-window--edit" id="settings-logout-all-window" hidden>
    <div class="app-window__panel" role="dialog" aria-modal="true" aria-labelledby="settings-logout-all-title">
      <div class="app-window__head">
        <h2 class="app-window__title" id="settings-logout-all-title" tabindex="-1">Log out of all devices</h2>
        <button type="button" class="app-window__close" id="settings-logout-all-close" aria-label="Close"><span class="app-icon app-icon--x" aria-hidden="true"></span></button>
      </div>
      <div class="app-window__body">
        <p>This logs you out of Pinalert on every phone and computer, including this one. You can sign in again any time with your email.</p>
        <p class="inline-error" id="settings-logout-all-error" role="alert" hidden></p>
        <div class="app-window__actions">
          <button type="button" class="btn btn--primary" id="settings-logout-all-go">Log out of all devices</button>
        </div>
      </div>
    </div>
  </div>

  <div class="app-window app-window--edit" id="settings-delete-window" hidden>
    <div class="app-window__panel" role="dialog" aria-modal="true" aria-labelledby="settings-delete-title">
      <div class="app-window__head">
        <h2 class="app-window__title" id="settings-delete-title" tabindex="-1">Delete my account</h2>
        <button type="button" class="app-window__close" id="settings-delete-close" aria-label="Close"><span class="app-icon app-icon--x" aria-hidden="true"></span></button>
      </div>
      <div class="app-window__body">
        <p>This cannot be undone.</p>
        <p>Your email, name, home area, updates, muted reports and settings are deleted, and you are logged out on every device.</p>
        {{/* Q2 owner confirmed 2026-10-18: Option A. Option B is the one sentence "Reports you posted and votes you made are removed, and reports other people confirmed with you may change." */}}
        <p id="settings-delete-rule">Reports you posted and votes you made stay, with no name or link to you, so nobody else's report changes.</p>
        <p class="inline-error" id="settings-delete-error" role="alert" hidden></p>
        <div class="app-window__actions">
          <button type="button" class="btn btn--primary" id="settings-delete-go">Delete my account</button>
        </div>
      </div>
    </div>
  </div>

  {{template "reader_dialog.html.tmpl" .}}

  {{template "app_bottombar" .}}

  <script src="/static/js/account-menu.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/app-bar.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/updates.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/settings.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/settings-alerts.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/reader.js?v={{.AssetVersion}}" defer></script>
</body>
</html>
