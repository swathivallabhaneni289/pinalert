<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  {{template "app_head" .AssetVersion}}
  <title>{{.PageTitle}}</title>
  <link rel="stylesheet" href="/static/css/main.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/auth.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/chrome.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/app-bar.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/places.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/window.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/updates.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/phone.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/stars.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/person.css?v={{.AssetVersion}}">
  <script src="/static/js/theme.js?v={{.AssetVersion}}"></script>
</head>
<body class="has-app-bar">
  <div class="top-chrome">
    {{template "app_topbar" .}}
  </div>
  <div id="notice-live" class="visually-hidden" role="status" aria-live="polite"></div>

  <div class="app-content">
  {{/* Phase 9 plan 08 (D-04, UI-SPEC Surface 1): one page for your own profile and for anyone else's. data-username and data-self are written only when there is a profile, so the not found page carries nothing from the request and is the same bytes for every cause (T-09-30). Every value below goes through html/template escaping. */}}
  <main id="person-page" class="person-page"{{if not (or .NotFound .LoadFailed)}} data-username="{{.Profile.Username}}" data-account-id="{{.AccountID}}" data-self="{{if .Profile.IsSelf}}true{{else}}false{{end}}"{{end}}>
    {{if .LoadFailed}}
    {{/* Review fix IN-T05 (UI-SPEC Surface 6, P9-C12): a profile read that failed. It holds nothing about the profile; Try again returns to the same address. */}}
    <section id="person-load-failed" class="person-state" aria-labelledby="person-load-failed-title">
      <h2 class="person-state__title" id="person-load-failed-title" tabindex="-1">Couldn't load this profile</h2>
      <p class="person-state__line">Check your connection and try again.</p>
      <a class="btn" href="{{.RetryHref}}">Try again</a>
    </section>
    {{else if .NotFound}}
    <section id="person-not-found" class="person-state" aria-labelledby="person-not-found-title">
      <h2 class="person-state__title" id="person-not-found-title" tabindex="-1">Profile not found</h2>
      <p class="person-state__line">There is no public profile with this username. It may have been made private, or the username may have changed.</p>
      <a class="btn" href="/">Go to Nearby</a>
    </section>
    {{else}}
    {{if not .BlockedByYou}}
    <header id="person-header" class="person-header">
      {{/* Quick 261113-t4y (owner decision 2026-11-13, the compact profile, mockup profile-compact): the header is one short centred column on both sizes, about half the height it was, and the DOM order is the reading order, so Tab and a screen reader follow what the eye sees: the letter, the username, the name, the counts (Stars, Followers, Following), the reporter tag line, Member since and the home area on one line, then the private line on your own page, the action row, Your rating on someone else's, and the action error line. This replaces the spacing of quick 261113-k9t, which stays centred. There are no wrappers except the counts group, the tag line, the details line and the edit panel, so every other part is a direct child of the header. */}}
      <span id="person-disc" class="person-disc" aria-hidden="true">{{.Profile.Initial}}</span>
      <h1 id="person-username" class="person-username">{{.Profile.Username}}</h1>
      {{/* Review fix IN-T02: under 900px the top bar title is the page's h1, so the username there is this plain line; person.css shows one of the two at each size. */}}
      <p class="person-username person-username--phone">{{.Profile.Username}}</p>
      {{/* On your own page the name line is always drawn and hidden while there is no name, so a name saved from the edit window fills it at once. */}}
      {{if or .Profile.Name .Profile.IsSelf}}<p id="person-name" class="person-name"{{if not .Profile.Name}} hidden{{end}}>{{.Profile.Name}}</p>{{end}}
      {{if .Profile.IsSelf}}
      {{/* Quick 261113-t4y (owner decision 2026-11-13): Edit profile opens this panel on the page, so Settings no longer holds About you. Each row opens the same small window Settings used to open, with the same rules; the three windows sit at the end of the body (profile_edit_windows.html.tmpl) and profile-edit.js drives the rows, the windows and Done. The rows keep the settings- ids of the windows they open. Done hides the panel and returns focus to Edit profile. */}}
      <div id="person-edit-panel" class="person-edit" hidden>
        <div class="place-box person-edit__box">
          <button type="button" class="place-row" id="settings-username-row" aria-haspopup="dialog" data-value="{{.Profile.Username}}">
            <span class="place-row__text"><span class="place-row__label">Username</span></span>
            <span class="place-row__value" id="settings-username-value">{{if .Profile.Username}}{{.Profile.Username}}{{else}}Not set{{end}}</span>
            <span class="app-icon app-icon--chevron-right" aria-hidden="true"></span>
          </button>
          <button type="button" class="place-row" id="settings-name-row" aria-haspopup="dialog" data-value="{{.Profile.Name}}">
            <span class="place-row__text"><span class="place-row__label">Name</span></span>
            <span class="place-row__value" id="settings-name-value">{{if .Profile.Name}}{{.Profile.Name}}{{else}}Not set{{end}}</span>
            <span class="app-icon app-icon--chevron-right" aria-hidden="true"></span>
          </button>
          <button type="button" class="place-row" id="settings-home-row" aria-haspopup="dialog" data-value="{{.Profile.HomeAreaName}}">
            <span class="place-row__text"><span class="place-row__label">Home area</span></span>
            <span class="place-row__value" id="settings-home-value">{{if .Profile.HomeAreaName}}{{.Profile.HomeAreaName}}{{else}}Not set{{end}}</span>
            <span class="app-icon app-icon--chevron-right" aria-hidden="true"></span>
          </button>
        </div>
        <button type="button" class="btn btn--primary person-edit__done" id="person-edit-done">Done</button>
      </div>
      {{end}}
      {{/* The counts group: one bordered group of three cells, Stars first when there is a total, then Followers and Following, each a number with its word under it and a thin line between the cells. The reporter tag is not a cell: it has its own line under the group. */}}
      <div id="person-stats" class="person-stats">
        {{if .Profile.StarsNumber}}
        <div id="person-stars" class="person-stars" role="group" aria-label="{{.Profile.StarsLabel}}">
          <span class="person-stars__icon" aria-hidden="true"></span>
          <span class="person-stars__total"><span class="person-stars__number">{{.Profile.StarsNumber}}</span> <span class="person-stars__word">Stars</span></span>
          {{/* Quick 261109-n25 (owner decision 2026-11-09, fewer words): the page draws the stars total alone. The two parts stay in the JSON route and in the group's accessible name (StarsLabel). */}}
        </div>
        {{end}}
        <button type="button" id="person-followers-button" class="person-count" aria-haspopup="dialog" aria-label="{{.Profile.FollowersText}}"><span id="person-followers-count" class="person-count__number">{{.Profile.FollowersCount}}</span> <span id="person-followers-word" class="person-count__word">{{.Profile.FollowersWord}}</span></button>
        <button type="button" id="person-following-button" class="person-count" aria-haspopup="dialog" aria-label="{{.Profile.FollowingText}}"><span id="person-following-count" class="person-count__number">{{.Profile.FollowingCount}}</span> <span id="person-following-word" class="person-count__word">{{.Profile.FollowingWord}}</span></button>
      </div>
      {{/* The reporter tag line: the chip, then its sentence. On the phone the sentence wraps under the chip. */}}
      <div id="person-tag-line" class="person-tag-line">
        <span id="person-tag" class="person-tag">{{.Profile.TagWord}}</span>
        <p id="person-tag-sentence" class="person-tag-sentence">{{.Profile.TagSentence}}</p>
      </div>
      {{/* The details line: Member since and the home area joined by a dot, no icons. On your own page the home area and its dot are always drawn and hidden while there is no home area, so a home area saved from the edit window fills them at once. */}}
      <p id="person-facts" class="person-facts"><span id="person-member-since" class="person-meta">{{.Profile.MemberSince}}</span>{{if or .Profile.HomeAreaName .Profile.IsSelf}}<span id="person-facts-dot" class="person-facts__dot" aria-hidden="true"{{if not .Profile.HomeAreaName}} hidden{{end}}> · </span><span id="person-home-area" class="person-meta person-meta--area"{{if not .Profile.HomeAreaName}} hidden{{end}}>{{.Profile.HomeAreaName}}</span>{{end}}</p>
      {{if and .Profile.IsSelf .Profile.StateLine}}
      <p id="person-state-line" class="person-state-line" role="status">{{.Profile.StateLine}}</p>
      {{end}}
      {{if .Profile.IsSelf}}
      <div id="person-actions" class="person-actions">
        <button type="button" id="person-edit" class="btn" aria-expanded="false" aria-controls="person-edit-panel">Edit profile</button>
      </div>
      {{else}}
      {{/* Follow and Following are both drawn and the server hides the one that does not apply, so the script only toggles the hidden flags and moves no markup. */}}
      <div id="person-actions" class="person-actions">
        <button type="button" id="person-follow" class="btn btn--primary"{{if not .Profile.CanFollow}} hidden{{end}}>Follow</button>
        <button type="button" id="person-unfollow" class="btn" aria-pressed="true"{{if not .Profile.Following}} hidden{{end}}>Following</button>
        {{/* Plan 09-24 (D-08, UI-SPEC 1d and 1e): the Notify me bell, after Following and before More. It is drawn always on another person's page and shown only while you follow them and have not muted them; the script toggles the hidden flag from the refetched profile. aria-pressed is the server's Notify flag (off by default). The icon (bell-off or bell) follows aria-pressed in person.css. The name is visually hidden text, so the username only goes through html/template escaping. */}}
        <button type="button" id="person-bell" class="person-bell" aria-pressed="{{if .Profile.Notify}}true{{else}}false{{end}}"{{if or (not .Profile.Following) .Profile.Muted}} hidden{{end}}><span class="person-bell__icon" aria-hidden="true"></span><span class="visually-hidden">Notify me when {{.Profile.Username}} posts</span></button>
        <button type="button" id="person-more" class="btn person-more" aria-haspopup="menu" aria-expanded="false" aria-controls="person-more-menu"><span>More</span><span class="person-more__chevron" aria-hidden="true"></span></button>
        <div id="person-more-menu" class="person-menu" role="menu" aria-label="More" hidden>
          {{/* Plan 09-20 (D-12, UI-SPEC 1e): Mute or Unmute is the first item, drawn always on another person's page. The label and data-muted are the server's Muted flag; the script flips both after a refetch of the profile. No confirmation. */}}
          <button type="button" id="person-mute-item" class="person-menu__item" role="menuitem" data-muted="{{if .Profile.Muted}}true{{else}}false{{end}}">{{if .Profile.Muted}}Unmute{{else}}Mute{{end}}</button>
          <button type="button" id="person-remove-follower" class="person-menu__item" role="menuitem"{{if not .Profile.FollowsYou}} hidden{{end}}>Remove follower</button>
          <button type="button" id="person-block" class="person-menu__item" role="menuitem">Block</button>
        </div>
      </div>
      {{if .Profile.MayRate}}
      {{/* Plan 09-16 (D-02, UI-SPEC 3a): the mount of the Your rating control. It is drawn only when the server says this reader may rate, and never on your own page. stars.js fills it. data-your-rating is the server's number, 0 when unrated. */}}
      <div id="person-rating" class="person-rating" data-your-rating="{{.Profile.YourRating}}"></div>
      {{end}}
      {{end}}
      <p id="person-action-error" class="inline-error" role="alert" hidden></p>
    </header>

    <section id="person-reports-section" class="person-reports" aria-labelledby="person-reports-title">
      <h2 id="person-reports-title" class="person-reports__title">Recent reports</h2>
      {{/* Plan 09-11 (D-06, D-07, UI-SPEC Surface 5): the rows are drawn here, on the server, as My activity draws its rows. person-reports.js only fills each Distance cell from the position Nearby kept. A live row is a link to the Phase 8 report link; a finished row is plain content with no link, no tabindex and no chevron, and its coordinates are the coarse cell centre. */}}
      <div id="person-reports" class="person-reports__list">
        {{if .ReportsFailed}}
        <div class="error-state person-reports__state" id="person-reports-error">
          <h3>Couldn't load reports</h3>
          <p>Check your connection and try again.</p>
          <a class="btn" href="/u/{{.Profile.Username}}">Try again</a>
        </div>
        {{else if not .Reports}}
        <div class="empty-state person-reports__state" id="person-reports-empty">
          <h3>No reports in the last 30 days</h3>
        </div>
        {{else}}
        <div class="person-report-box">
          <div class="person-report-cols" aria-hidden="true">
            <span class="person-report-cols__disc"></span>
            <span>Report</span>
            <span>Status</span>
            <span>When</span>
            <span>Distance</span>
          </div>
          <ol class="person-report-list">
            {{range .Reports}}
            {{if .Href}}
            <li class="person-report person-report--live {{.SeverityClass}}">
              <a class="person-report__body" href="{{.Href}}">
                <span class="icon-badge person-report__disc" aria-hidden="true"><span class="icon-glyph {{.IconGlyph}}"></span></span>
                <span class="person-report__report">{{if .AccessiblePrefix}}<span class="visually-hidden">{{.AccessiblePrefix}} </span>{{end}}<span class="person-report__title">{{.Title}}</span><span class="person-report__label">{{.LabelLine}}</span>{{if .DisputedLine}}<span class="person-report__disputed" aria-hidden="true">{{.DisputedLine}}</span>{{end}}</span>
                {{/* Review fix IN-T04: the hidden prefix already says Disputed or Not confirmed yet at the start of the row's name, so the visible line and the chip are skipped by a screen reader and the state is read once. */}}
                <span class="person-report__status"><span class="person-chip {{.ChipClass}}"{{if .AccessiblePrefix}} aria-hidden="true"{{end}}>{{.StatusWord}}</span></span>
                <span class="person-report__when">{{.WhenText}}</span>
                <span class="person-report__foot"><span class="person-report__distance" data-lat="{{.Lat}}" data-lon="{{.Lon}}" data-approx="{{.Approx}}"></span><span class="app-icon app-icon--chevron-right person-report__chevron" aria-hidden="true"></span></span>
              </a>
            </li>
            {{else}}
            <li class="person-report person-report--finished">
              <div class="person-report__body">
                <span class="icon-badge person-report__disc" aria-hidden="true"><span class="icon-glyph {{.IconGlyph}}"></span></span>
                <span class="person-report__report"><span class="visually-hidden">{{.AccessiblePrefix}} </span><span class="person-report__title">{{.Title}}</span>{{if .AreaLine}}<span class="person-report__label">{{.AreaLine}}</span>{{end}}</span>
                <span class="person-report__status"><span class="person-chip {{.ChipClass}}">{{.StatusWord}}</span></span>
                <span class="person-report__when">{{.WhenText}}</span>
                {{/* Quick 261109-n25: a finished row has no chevron, so with no distance its foot would be an empty bordered strip on the phone. It starts hidden and person-reports.js shows it only when it writes a distance. */}}
                <span class="person-report__foot" hidden><span class="person-report__distance" data-lat="{{.Lat}}" data-lon="{{.Lon}}" data-approx="{{.Approx}}"></span></span>
              </div>
            </li>
            {{end}}
            {{end}}
          </ol>
        </div>
        {{if .ReportsCut}}<p class="person-reports__cut">{{.ReportsCutText}}</p>{{end}}
        {{end}}
      </div>
    {{end}}

    {{if not .Profile.IsSelf}}
    {{/* The You blocked face. It is drawn by the server for a person you blocked, and hidden on a normal page for the script to fill and show after a confirmed Block. */}}
    <section id="person-blocked" class="person-state" aria-labelledby="person-blocked-title"{{if not .BlockedByYou}} hidden{{end}}>
      <h2 class="person-state__title" id="person-blocked-title" tabindex="-1">{{if .BlockedByYou}}You blocked {{.Profile.Username}}{{end}}</h2>
      <p class="person-state__line">They can't see your profile or follow you. Their reports still show in the feed.</p>
      <button type="button" id="person-unblock" class="btn">Unblock</button>
      <p id="person-blocked-error" class="inline-error" role="alert" hidden></p>
    </section>
    {{end}}
    {{end}}
  </main>
  </div>

  {{if and (not .NotFound) (not .LoadFailed) (not .Profile.IsSelf)}}
  {{/* The Block and Remove follower box, a native dialog with the Log out box classes, structured exactly like #settings-delete-confirm. It sits outside every window as a direct child of the body. The script fills the title and the text with textContent. */}}
  <dialog id="person-confirm" class="logout-confirm" aria-labelledby="person-confirm-title" aria-describedby="person-confirm-text">
    <div class="logout-confirm__body">
      <h2 class="logout-confirm__title" id="person-confirm-title" tabindex="-1"></h2>
      <div class="logout-confirm__text" id="person-confirm-text"></div>
      <p class="inline-error" id="person-confirm-error" role="alert" hidden></p>
      <div class="logout-confirm__actions">
        <button type="button" class="btn" id="person-confirm-cancel">Cancel</button>
        <button type="button" class="btn btn--destructive" id="person-confirm-go"></button>
      </div>
    </div>
  </dialog>
  {{end}}

  {{if and (not .NotFound) (not .LoadFailed) (not .BlockedByYou)}}
  {{/* The Followers and Following list window (plan 09-11, UI-SPEC Surface 4), opened by the two count buttons. */}}
  {{template "people_list_window" .}}
  {{end}}

  {{if and (not .NotFound) (not .LoadFailed) .Profile.IsSelf}}
  {{/* Quick 261113-t4y: the Username, Name and Home area edit windows, opened by the rows of the edit panel. They sit at the body level. */}}
  {{template "profile_edit_windows" .}}
  {{end}}

  {{/* Quick 261118-rz6: the author's box for their own removed report, opened from the bell. A direct child of body, never inside the bell dropdown. */}}

  {{template "review_ask_box.html.tmpl" .}}

  {{template "app_bottombar" .}}

  <script src="/static/js/account-menu.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/app-bar.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/updates.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/position.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/person-reports.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/people-list.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/stars.js?v={{.AssetVersion}}" defer></script>
  {{if and (not .NotFound) (not .LoadFailed) .Profile.IsSelf}}
  <script src="/static/js/username-check.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/profile-edit.js?v={{.AssetVersion}}" defer></script>
  {{end}}
  <script src="/static/js/person.js?v={{.AssetVersion}}" defer></script>
</body>
</html>
