<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  {{template "app_head" .AssetVersion}}
  <title>{{.PageTitle}}</title>
  <link rel="stylesheet" href="/static/css/main.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/auth.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/chrome.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/app-bar.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/places.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/window.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/updates.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/phone.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/person.css?v={{.AssetVersion}}">
  <script src="/static/js/theme.js?v={{.AssetVersion}}"></script>
</head>
<body class="has-app-bar">
  <div class="top-chrome">
    {{template "app_topbar" .}}
  </div>
  <div id="notice-live" class="visually-hidden" role="status" aria-live="polite"></div>

  <div class="app-content">
  {{/* Phase 9 plan 08 (D-04, UI-SPEC Surface 1): one page for your own profile and for anyone else's. data-username and data-self are written only when there is a profile, so the not found page carries nothing from the request and is the same bytes for every cause (T-09-30). Every value below goes through html/template escaping. */}}
  <main id="person-page" class="person-page"{{if not .NotFound}} data-username="{{.Profile.Username}}" data-account-id="{{.AccountID}}" data-self="{{if .Profile.IsSelf}}true{{else}}false{{end}}"{{end}}>
    {{if .NotFound}}
    <section id="person-not-found" class="person-state" aria-labelledby="person-not-found-title">
      <h2 class="person-state__title" id="person-not-found-title" tabindex="-1">Profile not found</h2>
      <p class="person-state__line">There is no public profile with this username. It may have been made private, or the username may have changed.</p>
      <a class="btn" href="/">Go to Nearby</a>
    </section>
    {{else}}
    {{if not .BlockedByYou}}
    <header id="person-header" class="person-header">
      <div class="person-ident">
        <span id="person-disc" class="person-disc" aria-hidden="true">{{.Profile.Initial}}</span>
        <div class="person-ident__text">
          <h1 id="person-username" class="person-username">{{.Profile.Username}}</h1>
          {{if .Profile.Name}}<p id="person-name" class="person-name">{{.Profile.Name}}</p>{{end}}
        </div>
      </div>
      {{if .Profile.StarsNumber}}
      <div id="person-stars" class="person-stars" role="group" aria-label="{{.Profile.StarsLabel}}">
        <span class="person-stars__icon" aria-hidden="true"></span>
        <span class="person-stars__total"><span class="person-stars__number">{{.Profile.StarsNumber}}</span> <span class="person-stars__word">stars</span></span>
      </div>
      {{end}}
      <div class="person-tag-group">
        <span id="person-tag" class="person-tag">{{.Profile.TagWord}}</span>
        <p id="person-tag-sentence" class="person-tag-sentence">{{.Profile.TagSentence}}</p>
      </div>
      <p id="person-member-since" class="person-meta">{{.Profile.MemberSince}}</p>
      {{if .Profile.HomeAreaName}}
      <p id="person-home-area" class="person-meta person-meta--area"><span class="app-icon app-icon--map-pin person-meta__icon" aria-hidden="true"></span><span>{{.Profile.HomeAreaName}}</span></p>
      {{end}}
      <div class="person-counts">
        <button type="button" id="person-followers-button" class="person-count" aria-haspopup="dialog" aria-label="{{.Profile.FollowersText}}"><span id="person-followers-count" class="person-count__number">{{.Profile.FollowersCount}}</span> <span id="person-followers-word" class="person-count__word">{{.Profile.FollowersWord}}</span></button>
        <button type="button" id="person-following-button" class="person-count" aria-haspopup="dialog" aria-label="{{.Profile.FollowingText}}"><span id="person-following-count" class="person-count__number">{{.Profile.FollowingCount}}</span> <span id="person-following-word" class="person-count__word">{{.Profile.FollowingWord}}</span></button>
      </div>
      {{if .Profile.IsSelf}}
      <div id="person-actions" class="person-actions">
        <a id="person-edit" class="btn" href="/settings">Edit in Settings</a>
      </div>
      <p id="person-state-line" class="person-state-line" role="status">{{.Profile.StateLine}}</p>
      {{else}}
      {{/* Follow and Following are both drawn and the server hides the one that does not apply, so the script only toggles the hidden flags and moves no markup. */}}
      <div id="person-actions" class="person-actions">
        <button type="button" id="person-follow" class="btn btn--primary"{{if not .Profile.CanFollow}} hidden{{end}}>Follow</button>
        <button type="button" id="person-unfollow" class="btn" aria-pressed="true"{{if not .Profile.Following}} hidden{{end}}>Following</button>
        <button type="button" id="person-more" class="btn person-more" aria-haspopup="menu" aria-expanded="false" aria-controls="person-more-menu"><span>More</span><span class="person-more__chevron" aria-hidden="true"></span></button>
        <div id="person-more-menu" class="person-menu" role="menu" aria-label="More" hidden>
          <button type="button" id="person-remove-follower" class="person-menu__item" role="menuitem"{{if not .Profile.FollowsYou}} hidden{{end}}>Remove follower</button>
          <button type="button" id="person-block" class="person-menu__item" role="menuitem">Block</button>
        </div>
      </div>
      {{end}}
      <p id="person-action-error" class="inline-error" role="alert" hidden></p>
    </header>

    <section id="person-reports-section" class="person-reports" aria-labelledby="person-reports-title">
      <h2 id="person-reports-title" class="person-reports__title">Recent reports</h2>
      <p class="person-reports__line">Reports from the last 30 days, newest first.</p>
      {{/* Plan 09-11 (D-06, D-07, UI-SPEC Surface 5): the rows are drawn here, on the server, as My activity draws its rows. person-reports.js only fills each Distance cell from the position Nearby kept. A live row is a link to the Phase 8 report link; a finished row is plain content with no link, no tabindex and no chevron, and its coordinates are the coarse cell centre. */}}
      <div id="person-reports" class="person-reports__list">
        {{if .ReportsFailed}}
        <div class="error-state person-reports__state" id="person-reports-error">
          <h3>Couldn't load reports</h3>
          <p>Check your connection and try again.</p>
          <a class="btn" href="/u/{{.Profile.Username}}">Try again</a>
        </div>
        {{else if not .Reports}}
        <div class="empty-state person-reports__state" id="person-reports-empty">
          <h3>No reports in the last 30 days</h3>
          <p>{{if .Profile.IsSelf}}Reports you post will show here.{{else}}Nothing from {{.Profile.Username}} in the last 30 days.{{end}}</p>
        </div>
        {{else}}
        <div class="person-report-box">
          <div class="person-report-cols" aria-hidden="true">
            <span class="person-report-cols__disc"></span>
            <span>Report</span>
            <span>Status</span>
            <span>When</span>
            <span>Distance</span>
          </div>
          <ol class="person-report-list">
            {{range .Reports}}
            {{if .Href}}
            <li class="person-report person-report--live {{.SeverityClass}}">
              <a class="person-report__body" href="{{.Href}}">
                <span class="icon-badge person-report__disc" aria-hidden="true"><span class="icon-glyph {{.IconGlyph}}"></span></span>
                <span class="person-report__report">{{if .AccessiblePrefix}}<span class="visually-hidden">{{.AccessiblePrefix}} </span>{{end}}<span class="person-report__title">{{.Title}}</span><span class="person-report__label">{{.LabelLine}}</span>{{if .DisputedLine}}<span class="person-report__disputed">{{.DisputedLine}}</span>{{end}}</span>
                <span class="person-report__status"><span class="person-chip {{.ChipClass}}">{{.StatusWord}}</span></span>
                <span class="person-report__when">{{.WhenText}}</span>
                <span class="person-report__foot"><span class="person-report__distance" data-lat="{{.Lat}}" data-lon="{{.Lon}}" data-approx="{{.Approx}}">Unknown</span><span class="app-icon app-icon--chevron-right person-report__chevron" aria-hidden="true"></span></span>
              </a>
            </li>
            {{else}}
            <li class="person-report person-report--finished">
              <div class="person-report__body">
                <span class="icon-badge person-report__disc" aria-hidden="true"><span class="icon-glyph {{.IconGlyph}}"></span></span>
                <span class="person-report__report"><span class="visually-hidden">{{.AccessiblePrefix}} </span><span class="person-report__title">{{.Title}}</span>{{if .AreaLine}}<span class="person-report__label">{{.AreaLine}}</span>{{end}}</span>
                <span class="person-report__status"><span class="person-chip {{.ChipClass}}">{{.StatusWord}}</span></span>
                <span class="person-report__when">{{.WhenText}}</span>
                <span class="person-report__foot"><span class="person-report__distance" data-lat="{{.Lat}}" data-lon="{{.Lon}}" data-approx="{{.Approx}}">Unknown</span></span>
              </div>
            </li>
            {{end}}
            {{end}}
          </ol>
        </div>
        {{if .ReportsCut}}<p class="person-reports__cut">{{.ReportsCutText}}</p>{{end}}
        {{end}}
      </div>
    {{end}}

    {{if not .Profile.IsSelf}}
    {{/* The You blocked face. It is drawn by the server for a person you blocked, and hidden on a normal page for the script to fill and show after a confirmed Block. */}}
    <section id="person-blocked" class="person-state" aria-labelledby="person-blocked-title"{{if not .BlockedByYou}} hidden{{end}}>
      <h2 class="person-state__title" id="person-blocked-title" tabindex="-1">{{if .BlockedByYou}}You blocked {{.Profile.Username}}{{end}}</h2>
      <p class="person-state__line">They can't see your profile or follow you. Their reports still show in the feed.</p>
      <button type="button" id="person-unblock" class="btn">Unblock</button>
      <p id="person-blocked-error" class="inline-error" role="alert" hidden></p>
    </section>
    {{end}}
    {{end}}
  </main>
  </div>

  {{if and (not .NotFound) (not .Profile.IsSelf)}}
  {{/* The Block and Remove follower box, a native dialog with the Log out box classes, structured exactly like #settings-delete-confirm. It sits outside every window as a direct child of the body. The script fills the title and the text with textContent. */}}
  <dialog id="person-confirm" class="logout-confirm" aria-labelledby="person-confirm-title" aria-describedby="person-confirm-text">
    <div class="logout-confirm__body">
      <h2 class="logout-confirm__title" id="person-confirm-title" tabindex="-1"></h2>
      <div class="logout-confirm__text" id="person-confirm-text"></div>
      <p class="inline-error" id="person-confirm-error" role="alert" hidden></p>
      <div class="logout-confirm__actions">
        <button type="button" class="btn" id="person-confirm-cancel">Cancel</button>
        <button type="button" class="btn btn--destructive" id="person-confirm-go"></button>
      </div>
    </div>
  </dialog>
  {{end}}

  {{template "app_bottombar" .}}

  <script src="/static/js/account-menu.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/app-bar.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/updates.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/position.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/person-reports.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/person.js?v={{.AssetVersion}}" defer></script>
</body>
</html>
