{{/* The one Flag dialog, shared by the main page and the Low data view. Static markup: the script in flag.js opens it, locks the page behind it and reads the ticked reasons and the optional note. Plan 04-31 (owner, 2026-10-22): a why question, the Dispute line under the title, tick boxes so more than one reason can be given, and a note box for the moderators. */}}
  <div class="modal-backdrop flag-dialog" id="flag-dialog" hidden>
    <div class="modal-panel flag-dialog__panel" role="dialog" aria-modal="true" aria-labelledby="flag-dialog-title" aria-describedby="flag-dialog-dispute">
      <h2 id="flag-dialog-title" class="flag-dialog__title" tabindex="-1">Why are you flagging this report?</h2>
      <p id="flag-dialog-dispute" class="flag-dialog__hint flag-dialog__dispute">If the report is just wrong, use Dispute instead.</p>
      <fieldset id="flag-dialog-reasons" class="flag-dialog__reasons" aria-labelledby="flag-dialog-title">
        <label class="flag-dialog__reason"><input type="checkbox" name="flag-reason" value="spam"><span class="flag-dialog__label">Spam or gibberish</span></label>
        <label class="flag-dialog__reason"><input type="checkbox" name="flag-reason" value="abusive"><span class="flag-dialog__label">Abusive or hateful</span></label>
        <label class="flag-dialog__reason"><input type="checkbox" name="flag-reason" value="false"><span class="flag-dialog__label">False or a hoax</span></label>
        <label class="flag-dialog__reason"><input type="checkbox" name="flag-reason" value="dangerous"><span class="flag-dialog__label">Dangerous or illegal</span></label>
        <label class="flag-dialog__reason"><input type="checkbox" name="flag-reason" value="other"><span class="flag-dialog__label">Something else</span></label>
      </fieldset>
      <p id="flag-dialog-choose" class="inline-note flag-dialog__choose" hidden>Choose a reason to continue.</p>
      <label for="flag-dialog-text" class="flag-dialog__text-label">Tell the moderators more (optional)</label>
      <textarea id="flag-dialog-text" class="flag-dialog__text" name="flag-note" rows="3" maxlength="300"></textarea>
      <p id="flag-dialog-count" class="flag-dialog__count" hidden></p>
      <p id="flag-dialog-text-error" class="inline-error flag-dialog__error" hidden></p>
      <p class="flag-dialog__reassurance">A flag never hides a post by itself. A moderator reads it. The author isn't told who flagged it.</p>
      <p id="flag-dialog-error" class="inline-error flag-dialog__error" hidden></p>
      <div class="flag-dialog__actions">
        <button type="button" id="flag-dialog-send" class="btn btn--primary">Send to moderators</button>
        <button type="button" id="flag-dialog-back" class="btn">Go back</button>
      </div>
    </div>
  </div>
