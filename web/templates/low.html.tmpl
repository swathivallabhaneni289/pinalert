<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Pinalert: Low data view</title>
  <link rel="stylesheet" href="/static/css/main.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/feed.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/trust.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/auth.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/chrome.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/low.css?v={{.AssetVersion}}">
  <link rel="stylesheet" href="/static/css/modal.css?v={{.AssetVersion}}">
  <script src="/static/js/theme.js?v={{.AssetVersion}}"></script>
</head>
<body>
  <div class="top-chrome">
    {{template "account_header.html.tmpl" .}}
  </div>
  {{template "theme_toggle.html.tmpl" .}}
  <div id="notice-live" class="visually-hidden" role="status" aria-live="polite"></div>
  <main class="low-page" id="app-shell"
        data-fallback-lat="{{.FallbackLat}}"
        data-fallback-lon="{{.FallbackLon}}"
        data-default-radius-km="{{.DefaultRadiusKm}}"
        data-poll-interval-ms="60000"
        data-vote-radius-km="{{.VoteRadiusKm}}"
        data-account-id="{{.AccountID}}">
    <div class="low-side">
    <div class="low-topbar">
      <a class="low-topbar__btn" id="low-full" href="/?full=1" aria-label="Back to the full version">
        <span class="low-topbar__icon" aria-hidden="true">&larr;</span>
        <span>Back</span>
      </a>
      <button type="button" class="low-topbar__btn low-topbar__btn--icon" id="low-reload" aria-label="Reload" title="Reload">
        <span class="low-topbar__icon" aria-hidden="true">&#8635;</span>
      </button>
    </div>
    <div class="low-page__head">
      <div class="low-block">
        <h1>Low data view</h1>
        <p class="low-page__line">Text only, no map</p>
        <p class="low-page__note">This device opens the Low data view by default.</p>
        <div class="low-page__actions">
          <button type="button" class="btn btn--primary low-page__report" id="low-report">Report an emergency</button>
        </div>
      </div>
      <div class="low-status">
        <p class="low-basis" id="low-basis" aria-live="polite"></p>
      </div>
      <div class="queue-strip" id="queue-strip" hidden></div>
      <div class="low-stale" id="low-stale" hidden>
        <p class="inline-note low-stale__text" id="low-stale-text"></p>
      </div>
    </div>
    </div>
    <div class="low-reports">
    <h2 id="low-list-heading">Active reports</h2>
    <ol class="low-list" id="low-list" aria-labelledby="low-list-heading" aria-busy="true"></ol>
    <div class="low-skeleton" id="low-skeleton" hidden>
      <div class="skeleton-row"></div>
      <div class="skeleton-row"></div>
      <div class="skeleton-row"></div>
      <div class="skeleton-row"></div>
    </div>
    <div class="empty-state" id="low-empty" hidden>
      <h2 id="low-empty-title"></h2>
      <p id="low-empty-text"></p>
    </div>
    <div class="error-state" id="low-error" hidden>
      <h2>Couldn't load reports</h2>
      <p>Check your connection, then use Reload at the top.</p>
    </div>
    </div>
  </main>

  <div class="modal-backdrop" id="report-modal" hidden>
    <div class="modal-panel report-form--low" role="dialog" aria-modal="true" aria-labelledby="modal-title">
      <h2 id="modal-title">Report an emergency</h2>
      <p id="form-note" class="inline-note" hidden></p>

      <fieldset class="low-location" aria-describedby="low-location-status">
        <legend>Location</legend>
        <p id="low-location-status" role="status"></p>
        <div class="low-location__actions" hidden>
          <button type="button" class="btn" id="low-location-use" hidden>Use this position</button>
          <button type="button" class="btn" id="low-location-own" hidden>Use my position instead</button>
          <button type="button" class="btn" id="low-location-retry" hidden>Retry position</button>
          <a class="btn" id="low-location-full" href="/?full=1" hidden>Open full version</a>
        </div>

        <label for="location-search">Or type a place or address</label>
        <div class="location-search-field">
          <input type="search" id="location-search" name="location_search" autocomplete="off"
                 autocapitalize="off" spellcheck="false" role="combobox" aria-expanded="false"
                 aria-autocomplete="list" aria-controls="location-search-results"
                 placeholder="Type a place name or address">
          <div id="location-search-results" role="listbox" aria-label="Place suggestions" hidden></div>
        </div>
        <p id="location-search-status" role="status" aria-live="polite" hidden></p>
      </fieldset>

      {{template "report_form.html.tmpl" .}}
    </div>
  </div>

  {{template "flag_dialog.html.tmpl" .}}
  <div id="toast" role="status" aria-live="polite" hidden></div>

  <script src="/static/js/app.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/votes.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/visibility.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/trust.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/queue.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/flag.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/report-form.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/low.js?v={{.AssetVersion}}" defer></script>
  <script src="/static/js/account-menu.js?v={{.AssetVersion}}" defer></script>
</body>
</html>
