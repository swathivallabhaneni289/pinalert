{{define "profile_edit_windows"}}
  {{/* Quick 261113-t4y (owner decision 2026-11-13, the compact profile): the Username, Name and Home area edit windows moved here from Settings, where they belonged to About you. They are opened by the three rows of the edit panel on your own profile page (person.html.tmpl) and driven by profile-edit.js. They must sit at the body level, outside the panel: the page lock silences every child of the body except the open window. The window and field ids keep their settings- names so the one contract that pins them carries over. */}}
  {{/* Phase 7.1 plan 15 (D-07, UI-SPEC Surface 8): the Username window is the built edit window. The field, the live line and the small line are step 4's (username-check.js). The input is named handle with autocomplete off, so a password manager never takes it for the login (T-07.1-30). Save username starts switched off with aria-disabled and the btn--off look, never the disabled attribute. Quick 261108-fku (owner decision 2026-11-08): inside the 7 day rename wait the server writes the moment the wait ends into data-wait-until (an RFC 3339 UTC time, and nothing outside the wait); on each opening profile-edit.js works out the days left from it, and the window opens read only with the wait sentence and one OK button, in place of Save username, or opens as usual when none are left. Review fix WR-02. */}}
  <div class="app-window app-window--edit" id="settings-username-window" hidden{{if .UsernameWaitUntil}} data-wait-until="{{.UsernameWaitUntil}}"{{end}}>
    <div class="app-window__panel" role="dialog" aria-modal="true" aria-labelledby="settings-username-title">
      <div class="app-window__head">
        <h2 class="app-window__title" id="settings-username-title">Username</h2>
        <button type="button" class="app-window__close" id="settings-username-close" aria-label="Close"><span class="app-icon app-icon--x" aria-hidden="true"></span></button>
      </div>
      <form class="app-window__body" id="settings-username-form" novalidate>
        <label class="app-window__label" for="settings-username-input">Username</label>
        <div class="username-field">
          <span class="username-field__at" aria-hidden="true">@</span>
          <input class="username-field__input" type="text" id="settings-username-input" name="handle" maxlength="20" autocomplete="off" autocapitalize="none" autocorrect="off" spellcheck="false" inputmode="text" enterkeyhint="done" aria-describedby="settings-username-status settings-username-help">
        </div>
        <p class="username-status" id="settings-username-status" role="status" aria-live="polite"></p>
        <p class="app-window__help" id="settings-username-help">Shown on your comments, to everyone.</p>
        <p class="inline-error" id="settings-username-error" role="alert" hidden></p>
        <div class="app-window__actions">
          <button type="submit" class="btn btn--off" id="settings-username-save" aria-disabled="true">Save username</button>
          <button type="button" class="btn btn--primary" id="settings-username-ok" aria-describedby="settings-username-status" hidden>OK</button>
        </div>
      </form>
    </div>
  </div>

  <div class="app-window app-window--edit" id="settings-name-window" hidden>
    <div class="app-window__panel" role="dialog" aria-modal="true" aria-labelledby="settings-name-title">
      <div class="app-window__head">
        <h2 class="app-window__title" id="settings-name-title">Name</h2>
        <button type="button" class="app-window__close" id="settings-name-close" aria-label="Close"><span class="app-icon app-icon--x" aria-hidden="true"></span></button>
      </div>
      <form class="app-window__body" id="settings-name-form" novalidate>
        {{/* Amended 2026-10-29 by Phase 7.1 plan 15 (UI-SPEC P71-C4, sketch 010 note): the label reads Name, like step 4 and the row. */}}
        <label class="app-window__label" for="settings-name-input">Name</label>
        <input class="app-window__field" type="text" id="settings-name-input" name="display_name" maxlength="60" autocomplete="name">
        <p class="inline-error" id="settings-name-error" role="alert" hidden></p>
        <div class="app-window__actions">
          <button type="submit" class="btn btn--primary" id="settings-name-save">Save name</button>
        </div>
      </form>
    </div>
  </div>

  <div class="app-window app-window--edit" id="settings-home-window" hidden>
    <div class="app-window__panel" role="dialog" aria-modal="true" aria-labelledby="settings-home-title">
      <div class="app-window__head">
        <h2 class="app-window__title" id="settings-home-title">Home area</h2>
        <button type="button" class="app-window__close" id="settings-home-close" aria-label="Close"><span class="app-icon app-icon--x" aria-hidden="true"></span></button>
      </div>
      <div class="app-window__body">
        <form id="settings-home-form" novalidate>
          <label class="app-window__label" for="settings-home-input">Home area</label>
          <input class="app-window__field" type="search" id="settings-home-input" name="q" maxlength="200" autocomplete="off" enterkeyhint="search" placeholder="Search a place" aria-describedby="settings-home-help settings-home-status">
        </form>
        <p class="app-window__help" id="settings-home-help">A town or area, never your street. Used for alerts.</p>
        <p class="app-window__status" id="settings-home-status" role="status" aria-live="polite" hidden></p>
        <ul class="app-window__results" id="settings-home-results" role="listbox" aria-label="Places found" hidden></ul>
        <p class="inline-error" id="settings-home-error" role="alert" hidden></p>
        {{/* Amended 2026-10-29 by Phase 7.1 plan 15 (D-15, UI-SPEC Surface 8): a home area can be changed but not removed, so the removal button and the sentence about removing it are gone, and Save home area is pressable: with nothing picked it says Choose a home area. */}}
        <div class="app-window__actions">
          <button type="button" class="btn btn--primary" id="settings-home-save">Save home area</button>
        </div>
      </div>
    </div>
  </div>
{{end}}
